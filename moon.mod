name = "liguanda888/mooneco"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/liguanda888/mooneco-mcp"

license = "Apache-2.0"

keywords = [ "mcp", "moonbit", "ai", "agent", "ecosystem", "context" ]

description = "MCP server giving AI coding agents MoonBit ecosystem knowledge (package/API retrieval, dependency suggestion) and MoonBit-semantic context packing"

preferred_target = "native"

import {
  "moonbitlang/async@0.22.1",
}
